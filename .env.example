# Copy to .env and fill in. .env is gitignored.

# n8n Webhook node URL. When set, NotifyOrderCreatedJob POSTs each new order here.
# Leave unset in development to skip the notification.
# For quick testing without n8n, point it at a https://webhook.site URL.
N8N_WEBHOOK_URL=

# Shared secret the SPA sends in X-Admin-Token to reach the panel endpoints
# (GET/PATCH orders, GET customers). Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Comma-separated list of allowed browser origins for CORS.
# Defaults to http://localhost:5173 (Vite dev server) when unset.
CORS_ORIGINS=http://localhost:5173

# Production only: full PostgreSQL connection string (Neon).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
